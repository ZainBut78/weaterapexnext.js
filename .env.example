# ══════════════════════════════════════════════════════════════
#  .env ka namoona — yeh file GitHub par jati hai (secret nahi).
#  Asli values `.env.local` mein hoti hain (woh GitHub par NAHI jati).
#
#  NEXT_PUBLIC_ = yeh value browser tak jati hai. Secret kabhi is
#  naam se na rakhein.
# ══════════════════════════════════════════════════════════════

# ── Option A: LIVE backend, proxy ke zariye (backend chalana nahi padta)
NEXT_PUBLIC_API_BASE_URL=/api
API_PROXY_TARGET=https://api.weatherapex.com

# ── Option B: apne computer ka backend (python manage.py runserver)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# (API_PROXY_TARGET wali line hata dein)

# ── Live (Hostinger) par:
# NEXT_PUBLIC_API_BASE_URL=https://api.weatherapex.com/api
# (API_PROXY_TARGET bilkul nahi)

# ── Server components ke liye backend ka POORA pata (relative /api
#    server par kaam nahi karta). Local: http://127.0.0.1:8000/api
#    Live:  https://api.weatherapex.com/api
API_INTERNAL_URL=https://api.weatherapex.com/api

# ── Backend ka internal key (SERVER-ONLY — NEXT_PUBLIC_ kabhi nahi).
#    Backend .env ke INTERNAL_API_KEY jaisi hi value. Asli value sirf
#    .env.local / Hostinger env mein. Khaali = header nahi bheja jata.
BACKEND_INTERNAL_KEY=

# ── Site ka apna domain (canonical, og:url, sitemap). API ka domain NAHI.
NEXT_PUBLIC_SITE_URL=https://weatherapex.com

# ── Google Sign-In (public hai, secret nahi)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=637612529072-41mk8f7bp6femvvibck84r2nt7vtd3se.apps.googleusercontent.com

# ── Beta par Google index NA kare (SERVER-ONLY, NEXT_PUBLIC_ nahi chahiye)
#    1 = har response par `X-Robots-Tag: noindex, nofollow`. robots.txt
#    crawling allow karta rehta hai (taake Google yeh header dekh sake).
#    Khaali / 0 = normal site. Main domain par cutover ke waqt HATA dein.
SITE_NOINDEX=

# ── SIRF local .env.local mein; live par NA rakhein
# HISTORY_READY_LOCAL=1            (fan-out sirf local DB ke mukammal shehron tak)

# ══════════════════════════════════════════════════════════════
#  HOSTINGER — beta.weatherapex.com (Node.js Web App, app type "next",
#  build script "build", output ".next", Node 22; Hostinger khud
#  `output: 'standalone'` lagata hai). Env build + runtime dono par.
#
#   NEXT_PUBLIC_API_BASE_URL=https://api.weatherapex.com/api
#   API_INTERNAL_URL=https://api.weatherapex.com/api
#   NEXT_PUBLIC_SITE_URL=https://beta.weatherapex.com
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID=<wahi jo upar hai>
#   BACKEND_INTERNAL_KEY=<secret — sirf Hostinger mein; backend INTERNAL_API_KEY jaisa>
#   SITE_NOINDEX=1
#   # NAHI: API_PROXY_TARGET, HISTORY_READY_LOCAL
#
#  MAIN (cutover — weatherapex.com):
#   NEXT_PUBLIC_SITE_URL=https://weatherapex.com
#   SITE_NOINDEX hata dein (ya 0)
#  API_PROXY_TARGET na hone par /api proxy rewrites band rehte hain
#  (sirf /favicon.ico wala rule rehta hai) aur browser seedha
#  api.weatherapex.com ko call karta hai — CORS backend sambhalta hai.
# ══════════════════════════════════════════════════════════════
